<span class="call-bar">
<% if Campfire::Rtc.jitsi_enabled? %>
  <div
    class="call-bar__jitsi"
    data-controller="jitsi-call"
    data-jitsi-call-url-value="<%= room_jitsi_call_path(room) %>"
    data-jitsi-call-room-id-value="<%= room.id %>"
    data-jitsi-call-error-text-value="<%= t("calls.connection_error") %>"
    data-action="turbo:before-cache@document->jitsi-call#close"
  >
    <button type="button" class="btn call-bar__button" data-action="jitsi-call#open" data-jitsi-call-media-param="audio" title="<%= t("calls.voice_room_title") %>">
      <%= image_tag "mobile-phone.svg", size: 20, aria: { hidden: true } %>
      <span class="call-bar__label"><%= t("calls.voice_short") %></span>
    </button>
    <button type="button" class="btn call-bar__button" data-action="jitsi-call#open" data-jitsi-call-media-param="video" title="<%= t("calls.video_room_title") %>">
      <%= image_tag "camera.svg", size: 20, aria: { hidden: true } %>
      <span class="call-bar__label"><%= t("calls.video_short") %></span>
    </button>

    <p role="alert" data-jitsi-call-target="error" hidden></p>
    <div class="call-webrtc-panel" data-jitsi-call-target="incoming" hidden>
      <p><%= t("calls.incoming") %></p>
      <button type="button" class="btn" data-action="jitsi-call#accept"><%= t("calls.accept") %></button>
      <button type="button" class="btn btn--negative" data-action="jitsi-call#decline"><%= t("calls.decline") %></button>
    </div>
    <dialog class="call-jitsi-dialog" data-jitsi-call-target="dialog" data-action="cancel->jitsi-call#close close->jitsi-call#close">
      <div class="call-jitsi-dialog__header">
        <button type="button" class="btn btn--small" data-action="jitsi-call#close"><%= t("calls.close") %></button>
      </div>
      <iframe class="call-jitsi-dialog__frame" title="<%= t("calls.group_call") %>" referrerpolicy="no-referrer" data-jitsi-call-target="frame" allow="camera; microphone; fullscreen; display-capture; autoplay"></iframe>
    </dialog>
  </div>

<% elsif room.direct? %>
  <div
    class="call-bar__webrtc"
    data-controller="webrtc-call"
    data-webrtc-call-room-id-value="<%= room.id %>"
    data-webrtc-call-ice-url-value="<%= room_webrtc_ice_path(room) %>"
    data-webrtc-call-calling-text-value="<%= t("calls.calling") %>"
    data-webrtc-call-incoming-text-value="<%= t("calls.incoming") %>"
    data-webrtc-call-connected-text-value="<%= t("calls.connected") %>"
    data-webrtc-call-declined-text-value="<%= t("calls.declined") %>"
    data-webrtc-call-media-error-text-value="<%= t("calls.media_error") %>"
    data-webrtc-call-lost-text-value="<%= t("calls.lost") %>"
  >
    <button type="button" class="btn call-bar__button" data-action="webrtc-call#startAudio" title="<%= t("calls.voice_title") %>">
      <%= image_tag "mobile-phone.svg", size: 20, aria: { hidden: true } %>
      <span class="call-bar__label"><%= t("calls.voice_short") %></span>
    </button>
    <button type="button" class="btn call-bar__button" data-action="webrtc-call#startVideo" title="<%= t("calls.video_title") %>">
      <%= image_tag "camera.svg", size: 20, aria: { hidden: true } %>
      <span class="call-bar__label"><%= t("calls.video_short") %></span>
    </button>

    <div class="call-webrtc-panel" data-webrtc-call-target="panel" hidden>
      <p class="call-webrtc-panel__status" data-webrtc-call-target="status"></p>

      <div class="call-webrtc-panel__incoming" data-webrtc-call-target="incomingRow" hidden>
        <button type="button" class="btn" data-action="webrtc-call#accept"><%= t("calls.accept") %></button>
        <button type="button" class="btn btn--negative" data-action="webrtc-call#decline"><%= t("calls.decline") %></button>
      </div>

      <div data-webrtc-call-target="activeRow" hidden>
        <div class="call-webrtc-panel__videos">
          <video data-webrtc-call-target="localVideo" playsinline muted hidden></video>
          <video data-webrtc-call-target="remoteVideo" playsinline></video>
        </div>
        <div class="call-webrtc-panel__toolbar">
          <button type="button" class="btn" data-action="webrtc-call#toggleMute" data-webrtc-call-target="muteButton" aria-pressed="false"><%= t("calls.mute") %></button>
          <button type="button" class="btn btn--negative" data-action="webrtc-call#hangup"><%= t("calls.hang_up") %></button>
        </div>
      </div>
    </div>
  </div>

<% else %>
  <div class="call-bar__hint" data-controller="call-hint">
    <button type="button" class="btn call-bar__button" data-action="call-hint#show" title="<%= t("calls.voice_title") %>">
      <%= image_tag "mobile-phone.svg", size: 20, aria: { hidden: true } %>
      <span class="call-bar__label"><%= t("calls.voice_short") %></span>
    </button>
    <button type="button" class="btn call-bar__button" data-action="call-hint#show" title="<%= t("calls.video_title") %>">
      <%= image_tag "camera.svg", size: 20, aria: { hidden: true } %>
      <span class="call-bar__label"><%= t("calls.video_short") %></span>
    </button>

    <dialog class="call-hint-dialog" data-call-hint-target="dialog">
      <div class="call-hint-dialog__inner">
        <h2 class="call-hint-dialog__title"><%= t("calls.ping_only_title") %></h2>
        <p class="call-hint-dialog__body"><%= t("calls.ping_only_body") %></p>
        <button type="button" class="btn" data-action="call-hint#close"><%= t("calls.got_it") %></button>
      </div>
    </dialog>
  </div>
<% end %>
</span>
